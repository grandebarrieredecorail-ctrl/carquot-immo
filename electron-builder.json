{
  "appId": "com.carquot.immo",
  "productName": "Carquot Immo",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "main.cjs"
  ],
  "extraMetadata": {
    "main": "main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
